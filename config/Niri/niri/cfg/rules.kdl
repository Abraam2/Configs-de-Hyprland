// ----------------------------------------------------------------------------
// Window rules / layer rules
// ----------------------------------------------------------------------------

// ID de todo lo que esté abierto
// niri-apps-id alias 
// niri msg -j windows | jq -r '.[] | "\(.title) -> \(.app_id)"'

// niri-select-app-id alias
// ID de una aplicación que selecciones
// niri msg pick-window
//

// 2. Regla para el portal de escritorio GTK (Selector de archivos, etc.)
window-rule {
    match app-id=r"xdg-desktop-portal-gtk"
    open-floating true
    default-column-width { fixed 1200; }
    default-window-height { fixed 700; }
}

// 3. Regla por títulos comunes de avisos y diálogos (Afinada)
window-rule {
    match title=r"^(Open File|Confirm|Error|Warning|Settings|Preferences|Guardar como|Abrir|Confirmar)$"
    open-floating true
}

// 4. Regla específica para Nemo (Propiedades de archivos)
window-rule {
    match app-id=r"nemo" title=r"(Properties|Propiedades)"
    open-floating true
    default-column-width { fixed 800; }
    default-window-height { fixed 600; }
}

// 5. Regla para FileRoller (Gestor de archivadores de GNOME)
window-rule {
    match app-id=r"org\.gnome\.FileRoller" title=r"(Extraer|Comprimir|Añadir|Añadiendo|Creando)"
    open-floating true
    default-column-width { fixed 450; }
    default-window-height { fixed 180; }
}
window-rule {
    // Slight rounded corners.
    geometry-corner-radius 10
    clip-to-geometry true
    // match is-floating=false
    // tiled-state true
}

// Assorted window rules.
window-rule {
    match app-id=r"^Pinentry-gtk$"
    match app-id=r"^Tk$"
    match app-id=r"^gimp$" title=r"Preferences"
    match app-id=r"^soffice$" title=r"^Text Import"
    match app-id=r"^thunar$" title=r"^Rename "
    match app-id=r"^virt-manager$" title=r" - Connection Details"
    match app-id=r"^wev$"
    match app-id=r"^xarchiver$"
    match app-id=r"^xarchiver$"
    // match app-id=r"^VirtualBox$"
    match app-id=r"firefox$" title=r"^(Picture-in-Picture|Library|About Mozilla Firefox|Firefox - Choose a profile)$"

    open-floating true
}

window-rule {
    match app-id=r"^dfr\.floating\.ghostty$"
    match app-id=r"^dfr\.floating\.thunar$"

    open-floating true
    default-column-width { proportion 0.33; }
    default-window-height { proportion 0.5; }
}

window-rule {
    match app-id=r"^com\.gabm\.satty$"
    open-floating true
    min-width 730
    min-height 300
}

window-rule {
    match app-id=r"^KeePassXC$"
    block-out-from "screencast"
}


// Aplicaciones que quires que se abran maximizadas

window-rule {
    match app-id=r"(Cemu|vlc|mpv|eden|dolphin-emu|pcsx2-qt|steam|org-jdownloader-update-launcher-JDLauncher)"
    open-maximized true
}

window-rule {
    match app-id=r"^VirtualBox Machine$"
    default-column-width { proportion 1.0; }
}

// Window ID 67: (focused)
//   Title: "Tiny10 [Corriendo] - Oracle VirtualBox"
//   App ID: "VirtualBox Machine"
//   Is floating: no
//   PID: 1822
//   Workspace ID: 3
//   Layout:
//     Tile size: 945 x 1030
//     Scrolling position: column 2, tile 1
//     Window size: 939 x 1024
//     Window offset in tile: 3 x 3

// Oniri

// Opciones para que si solo hay una ventana abierta en el workspace, se abra maximizada
// https://github.com/Antiz96/oniri/

window-rule {
    draw-border-with-background false
}
layer-rule {
    match namespace="^noctalia-wallpaper*"
    place-within-backdrop true
}



