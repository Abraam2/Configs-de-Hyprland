    on-primary-fixed: #001d32;
    on-primary-fixed-variant: #004b74;
    primary-container: #004b74;
    on-primary-container: #cde5ff;
    secondary: #b9c8da;
    secondary-fixed: #d4e4f6;
    secondary-fixed-dim: #b9c8da;
    on-secondary: #233240;
    on-secondary-fixed: #0d1d2a;
    on-secondary-fixed-variant: #394857;
    secondary-container: #394857;
    on-secondary-container: #d4e4f6;
    tertiary: #d2bfe7;
    tertiary-fixed: #eedcff;
    tertiary-fixed-dim: #d2bfe7;
