#!/usr/bin/env bash

RENAME_NUM=false
FILES=()

for arg in "$@"; do
    case "$arg" in
    -n | --num) RENAME_NUM=true ;;
    *) FILES+=("$arg") ;;
    esac
done

for f in "${FILES[@]}"; do
    [[ ! -f "$f" ]] && continue
    dir=$(dirname "$f")
    base=$(basename "$f")
    name="${base%.*}"

    if [ "$RENAME_NUM" = true ]; then
        ep=$(echo "$name" | grep -oE '( - |[Ee])[0-9]{1,3}' | grep -oE '[0-9]{1,3}' | head -n 1)
        if [ -z "$ep" ]; then
            ep=$(echo "$name" | sed -E 's/1080p|720p|480p|2160p//g' | grep -oE '[0-9]{2,3}' | tail -n 1)
        fi
        out_name="${ep:-$name}.mp4"
    else
        out_name="${name}.mp4"
    fi

    # 1. Busca la pista de audio AAC
    aac_idx=$(ffprobe -v error -select_streams a -show_entries stream=index,codec_name -of csv=p=0 "$f" | grep -ni 'aac' | head -n 1 | cut -d':' -f1)
    audio_map=${aac_idx:+$((aac_idx - 1))}
    audio_map=${audio_map:-0}

    # 2. Busca la pista de subtítulos en español (spa o es)
    rel_sub=$(ffprobe -v error -select_streams s -show_entries stream=index:stream_tags=language -of csv=p=0 "$f" | grep -niE 'spa|es' | head -n 1 | cut -d':' -f1)

    if [ -n "$rel_sub" ]; then
        sub_idx=$((rel_sub - 1))
        echo ">>> Empaquetando (1 seg): $base -> $out_name (Audio AAC: $audio_map | Sub Español: $sub_idx)"
        ffmpeg -hide_banner -loglevel error -y \
            -i "$f" \
            -map 0:v:0 -map "0:a:${audio_map}" -map "0:s:${sub_idx}" \
            -c:v copy -c:a copy -c:s mov_text \
            "$dir/$out_name"
    else
        echo ">>> Aviso: No hay pista marcada como español en $base, usando la primera pista de subtítulos (0)"
        ffmpeg -hide_banner -loglevel error -y \
            -i "$f" \
            -map 0:v:0 -map "0:a:${audio_map}" -map 0:s:0 \
            -c:v copy -c:a copy -c:s mov_text \
            "$dir/$out_name"
    fi
done

echo ">>> ¡Todos convertidos al instante!"
